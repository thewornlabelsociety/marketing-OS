# Marketing OS — Environment Variables
# Copy this file to backend/.env and fill in values.
# Never commit backend/.env — it is gitignored.

# ── Server ────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────
# SQLite only (no Postgres). The database file is created automatically.
# Default location: backend/app_data.db
# Set SQLITE_PATH to move it. DB_PATH has no effect (legacy config stub).
# SQLITE_PATH=./app_data.db

# ── AI Provider ───────────────────────────────────────────────────
# Leave unset to disable AI planning. The app works without it.
# AI_PROVIDER=anthropic   # anthropic | openai | gemini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Model overrides (optional — sensible defaults are used per provider)
# AI_CAMPAIGN_MODEL=claude-opus-4-5
# AI_REVISION_MODEL=claude-sonnet-4-5

# ── Meta / Facebook / Instagram ───────────────────────────────────
# META_MOCK_MODE=1 keeps all Meta calls simulated (safe for local dev).
# Remove or empty it only when testing against real Meta APIs.
# META_MOCK_MODE=1
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:4100/api/integrations/meta/callback
# META_GRAPH_API_VERSION=v21.0
# META_PAGE_ACCESS_TOKEN=   # Page token (not User token). Required for live publishing.
#                             Get from Graph API Explorer → select your Page → generate token.

# ── Credential Vault ──────────────────────────────────────────────
# AES-256-GCM encryption key for stored OAuth tokens.
# Any string is accepted (hashed to 32 bytes internally).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key makes all stored tokens permanently unreadable.
# CREDENTIAL_ENCRYPTION_KEY=

# ── Media Delivery ────────────────────────────────────────────────
# MEDIA_PUBLIC_BASE_URL must be a publicly reachable URL for live Meta publishing.
# Meta fetches image URLs at publish time — localhost is explicitly rejected in live mode.
# MEDIA_PUBLIC_BASE_URL=http://localhost:4100
# MEDIA_DELIVERY_SECRET=    # HMAC key for signed media URLs.
#                             Generate same way as CREDENTIAL_ENCRYPTION_KEY.
# MEDIA_SIGNED_URL_TTL_SECONDS=86400   # Min 60, max 604800 (7 days)
# MEDIA_STORAGE_ROOT=       # Absolute path for media uploads. Defaults to backend/data/media

# ── Publishing Scheduler (optional) ──────────────────────────────
# DEFAULT_SCHEDULE_TIMEZONE=UTC        # IANA timezone. Defaults to UTC.
# PUBLISHING_POLL_MS=30000             # Scheduler poll interval in ms. Defaults to 30 s.
