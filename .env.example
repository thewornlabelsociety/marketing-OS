# Marketing OS — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4100
NODE_ENV=development

# Database (optional — defaults to ./app_data.db)
# DB_PATH=./data/app_data.db

# AI Provider
# Select which AI provider to use: anthropic | openai | gemini
# AI_PROVIDER=anthropic

# Anthropic (required when AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# OpenAI (required when AI_PROVIDER=openai)
# OPENAI_API_KEY=

# Google Gemini (required when AI_PROVIDER=gemini)
# GEMINI_API_KEY=

# Model overrides (optional — sensible defaults are used per provider)
# AI_CAMPAIGN_MODEL=claude-opus-4-5
# AI_REVISION_MODEL=claude-sonnet-4-5

# Integrations (optional — not yet implemented)
# META_APP_ID=
# META_APP_SECRET=
