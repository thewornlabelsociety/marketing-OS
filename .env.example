# Marketing OS — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4100
NODE_ENV=development

# Database (optional — defaults to ./app_data.db)
# DB_PATH=./data/app_data.db

# AI (required for content generation — not yet implemented)
# ANTHROPIC_API_KEY=

# Integrations (optional — not yet implemented)
# META_APP_ID=
# META_APP_SECRET=
