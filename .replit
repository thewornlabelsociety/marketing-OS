modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "(cd backend && PORT=4100 npm run dev) & (cd frontend && npm run dev)"
waitForPort = 5000

[[ports]]
localPort = 4100
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "cd backend && npm install --include=dev && npm run build && cd ../frontend && npm install --include=dev && npm run build"]
run = ["sh", "-c", "(cd backend && PORT=4100 npm start) & (cd frontend && npm run preview -- --host 0.0.0.0 --port 5000)"]
