# MarketingOS backend — copy to .env locally. Never commit real values.
PORT=4100
NODE_ENV=development
CREDENTIAL_ENCRYPTION_KEY=
MEDIA_DELIVERY_SECRET=
DEFAULT_SCHEDULE_TIMEZONE=Pacific/Auckland
PUBLISHING_POLL_MS=15000
AI_PROVIDER=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
MEDIA_PUBLIC_BASE_URL=

# Safe Business Integration: Worn Label (all required to enable sync)
WORN_LABEL_WORKSPACE_ID=worn-label
WORN_LABEL_API_BASE_URL=
WORN_LABEL_SERVICE_TOKEN=
WORN_LABEL_SYNC_INTERVAL_MINUTES=15
