{
  "name": "marketing-os-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "verify:phase-3c": "node scripts/run-verify-phase-3c.cjs",
    "verify:phase-3d": "node scripts/run-verify-phase-3d.cjs",
    "verify:phase-3e": "node scripts/run-verify-phase-3e.cjs",
    "verify:phase-3f": "node scripts/run-verify-phase-3f.cjs",
    "verify:phase-3g": "node scripts/run-verify-phase-3g.cjs",
    "verify:phase-3h": "node scripts/run-verify-phase-3h.cjs",
    "postbuild": "node -e \"const fs=require('fs');const p='dist/db';fs.mkdirSync(p,{recursive:true});fs.copyFileSync('src/db/schema.sql',p+'/schema.sql')\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
